# Enciende el workbench de postulación en /apply.
# Ausente o distinto de 1  ⇒  /apply muestra sólo las instrucciones de uso local.
CV_AI_ENABLED=1

# Sólo decide el rótulo del botón en el cliente. No habilita nada por sí misma.
NEXT_PUBLIC_CV_AI_ENABLED=1

# Motor de IA: claude (por defecto) · gemini · mock
# ⛔ `gemini` cambia una garantia: con el Agent SDK el "solo local" es estructural
#    (en la nube no existe el binario `claude`); una API key viaja a cualquier lado.
#    Si usas gemini, la key NO se configura nunca en el despliegue.
CV_AI_PROVIDER=claude

# Modelo que usa el Claude Agent SDK.
CV_AI_MODEL=claude-opus-5-5

# Solo si CV_AI_PROVIDER=gemini. La key se saca en https://aistudio.google.com/apikey
# y va en .env.local, que esta en .gitignore. NUNCA en .env.example ni en un commit.
GEMINI_API_KEY=
CV_GEMINI_MODEL=gemini-3.6-flash

# Dónde se guardan las postulaciones generadas (está en .gitignore).
CV_APPLICATIONS_DIR=.applications

# Timeout de la impresión a PDF con Playwright.
CV_PDF_TIMEOUT_MS=30000
