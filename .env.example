# Enciende el workbench de postulación en /apply.
# Ausente o distinto de 1  ⇒  /apply muestra sólo las instrucciones de uso local.
CV_AI_ENABLED=1

# Sólo decide el rótulo del botón en el cliente. No habilita nada por sí misma.
NEXT_PUBLIC_CV_AI_ENABLED=1

# Modelo que usa el Claude Agent SDK.
CV_AI_MODEL=claude-opus-5

# Dónde se guardan las postulaciones generadas (está en .gitignore).
CV_APPLICATIONS_DIR=.applications

# Timeout de la impresión a PDF con Playwright.
CV_PDF_TIMEOUT_MS=30000
